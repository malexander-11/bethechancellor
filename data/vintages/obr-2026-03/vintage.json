  "sensitivities": [
    {
      "id": "rates1pp",
      "title": "Bank Rate and gilt yields, +1 percentage point (sustained)",
      "description": "The OBR estimates that a sustained 1 percentage point increase in Bank Rate and gilt yields would raise borrowing by £15 billion in 2030-31, and that a 1 percentage point fall would lower it by a broadly similar amount. The November 2025 forecast gave £16 billion for 2029-30.",
      "unit": "pp",
      "perUnit": 1,
      "effectOnPsnbGbpm": {
        "2026-27": 10000,
        "2027-28": 15000,
        "2028-29": 15000,
        "2029-30": 15000,
        "2030-31": 15000
      },
      "currentBudgetShare": 1,
      "adjusts": [
        {
          "target": "marginalInterestRate",
          "how": "adds the slider value to the marginal rate on new borrowing"
        }
      ],
      "rampNote": "OBR states the end-year effect only. 2027-28 onwards is held at £15bn (the OBR's £16bn for 2029-30 in November 2025 and £15bn for 2030-31 in March 2026 imply a broadly flat profile). 2026-27 is set at two-thirds of that because Bank Rate passes through to reserves remuneration immediately while gilt refinancing is gradual; this first-year figure is an assumption.",
      "provisional": true,
      "source": {
        "sourceId": "obr-efo-2026-03",
        "paragraph": "1.21 and 6.16",
        "quote": "A sustained 1 percentage point increase in Bank Rate and gilt yields would increase borrowing by £15 billion in 2030-31"
      },
      "secondarySource": {
        "sourceId": "obr-efo-2025-11",
        "quote": "A 1 percentage point increase in Bank Rate and gilt yields would reduce the current surplus by £16 billion in 2029-30"
      }
    },
    {
      "id": "nominalGrowth0p1pp",
      "title": "Nominal GDP growth, +0.1 percentage point a year",
      "description": "The OBR estimates that a 0.1 percentage point change in nominal GDP growth in each year changes borrowing by £8 billion in 2030-31. Higher growth lowers borrowing.",
      "unit": "pp",
      "perUnit": 0.1,
      "effectOnPsnbGbpm": {
        "2026-27": -1600,
        "2027-28": -3200,
        "2028-29": -4800,
        "2029-30": -6400,
        "2030-31": -8000
      },
      "currentBudgetShare": 1,
      "adjusts": [
        {

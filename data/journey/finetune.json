  "spending": {
    "title": "Fine-tune spending",
    "lead": "Trim or top up any budget. A top-up costs what a trim saves.",
    "notes": [
      {
        "text": "Departments’ day-to-day budgets are set to 2028-29. Cutting one reopens a minister’s deal.",
        "badge": "simulated",
        "sources": [
          {
            "sourceId": "obr-efo-2026-03",
            "paragraph": "4.14"
          },
          {
            "sourceId": "hmt-sr25-del-tables"
          }
        ]
      },
      {
        "text": "After that, the forecast already has the budgets it does not protect falling 4.4% a year after inflation.",
        "badge": "direct",
        "sources": [
          {
            "sourceId": "obr-efo-2026-03",
            "paragraph": "4.16"
          }
        ]
      },
      {
        "text": "Most public services here are England’s budgets. The other nations get a share through their own grants (the Barnett formula), which our prices leave out.",
        "badge": "commentary",
        "sources": [
          {
            "sourceId": "hmt-statement-of-funding-policy-2025",
            "note": "Annex B.13, comparability factors at Spending Review 2025"
          }
        ]
      }
    ],
    "adviser": "director-of-public-spending",

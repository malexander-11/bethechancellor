{
  "schemaVersion": 1,
  "intro": "The Budget is out. Three audiences read it, and each says why.",
  "audiences": [
    {
      "id": "backbenchers",
      "title": "Your backbenchers",
      "question": "Is this a Labour Budget?",
      "labels": ["In revolt", "Grumbling", "Divided", "Onside", "Cheering"],
      "rules": [
        {
          "id": "bb-public-services",
          "measure": "publicServiceSpendingGbpm",
          "reading": {
            "label": "Change in public spending in the target year",
            "unit": "GBPm"
          },
          "note": "A change of about a fifth of March’s £23.6bn headroom either way is the threshold: below that the benches do not feel it.",
          "nudge": "{gap} more for public services would have moved the backbenchers up a band.",
          "bands": [
            {
              "id": "cut",
              "upTo": -5000,
              "points": -1,
              "text": "Public services lose {abs} against the Spending Review. A minister will name the service that pays.",
              "sources": [
                {
                  "sourceId": "hmt-sr25-del-tables"
                },
                {
                  "sourceId": "obr-efo-2026-03",
                  "paragraph": "4.16"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "steady",
              "upTo": 5000,
              "points": 0,
              "text": "Public spending is about where the Spending Review left it ({value}).",
              "sources": [
                {
                  "sourceId": "hmt-sr25-del-tables"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "more",
              "points": 1,
              "text": "Public services get {abs} more than the Spending Review planned. That is what the party came in to do.",
              "sources": [
                {
                  "sourceId": "hmt-sr25-del-tables"
                }
              ],
              "badge": "simulated"
            }
          ]
        },
        {
          "id": "bb-welfare-reversals",
          "measure": "welfareReversals",
          "reading": {
            "label": "Welfare decisions of Budget 2025 reversed",
            "unit": "count"
          },
          "note": "Any reversal counts; the two-child limit, the PIP changes and winter fuel were the three fights of last November.",
          "bands": [
            {
              "id": "stand",
              "upTo": 0,
              "points": 0,
              "text": "Last November’s welfare U-turns stand. Ending the two-child limit was scored as lifting 450,000 children out of poverty.",
              "sources": [
                {
                  "sourceId": "hmt-budget-2025-document"
                },
                {
                  "sourceId": "hmt-budget-2025-table-4-1"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "one",
              "upTo": 1,
              "points": -1,
              "text": "A welfare cut the party fought to reverse is back. Last year’s argument now runs backwards.",
              "sources": [
                {
                  "sourceId": "hmt-budget-2025-document"
                },
                {
                  "sourceId": "hmt-budget-2025-table-4-1"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "several",
              "points": -2,
              "text": "More than one of last November’s welfare U-turns is undone. The left of the party will fight again.",
              "sources": [
                {
                  "sourceId": "hmt-budget-2025-document"
                },
                {
                  "sourceId": "hmt-budget-2025-table-4-1"
                }
              ],
              "badge": "simulated"
            }
          ]
        },
        {
          "id": "bb-welfare-cut",
          "measure": "welfareChangeGbpm",
          "reading": {
            "label": "Change in working-age and pensioner benefits in the target year",
            "unit": "GBPm"
          },
          "note": "A cut of more than about £2bn a year is felt in benefit rates; smaller moves are absorbed in uprating.",
          "nudge": "{gap} less off benefits would have moved this up a band.",
          "bands": [
            {
              "id": "cut",
              "upTo": -2000,
              "points": -1,
              "text": "Benefits are cut by {abs} a year. The benches will ask who this falls on.",
              "sources": [
                {
                  "sourceId": "dwp-benefit-expenditure-2026"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "steady",
              "points": 0,
              "text": "Benefit spending is about where the forecast had it ({value}).",
              "sources": [
                {
                  "sourceId": "dwp-benefit-expenditure-2026"
                }
              ],
              "badge": "simulated"
            }
          ]
        },
        {
          "id": "bb-who-pays",
          "measure": "progressiveBalanceGbpm",
          "reading": {
            "label": "Revenue from the top and business, less revenue from everyone else",
            "unit": "GBPm"
          },
          "note": "The balance of new revenue: the best-off, savers and business on one side; everyone who earns or spends, motorists and duties on the other. Two billion either way is the threshold.",
          "nudge": "{gap} more from the best-off and business, rather than the broad base, would have moved this up.",
          "bands": [
            {
              "id": "broad",
              "upTo": -2000,
              "points": -1,
              "text": "The new money comes mainly from everyone, motorists and duties, not the top: {abs} net. The benches remember the manifesto.",
              "sources": [
                {
                  "sourceId": "labour-manifesto-2024-strong-foundations"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "even",
              "upTo": 2000,
              "points": 0,
              "text": "What is raised is spread between the broad base and the top ({value} net).",
              "sources": [
                {
                  "sourceId": "labour-manifesto-2024-strong-foundations"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "top",
              "points": 1,
              "text": "More is asked of the best-off, wealth and business than of everyone else: {abs} net. The benches wanted this.",
              "sources": [
                {
                  "sourceId": "labour-manifesto-2024-strong-foundations"
                }
              ],
              "badge": "simulated"
            }
          ]
        },
        {
          "id": "bb-manifesto",
          "measure": "manifestoBroken",
          "reading": {
            "label": "Manifesto red lines crossed",
            "unit": "count"
          },
          "note": "The tax lock, the corporation tax cap, the two-child limit, the defence path and the triple lock, as the PM file lists them.",
          "bands": [
            {
              "id": "kept",
              "upTo": 0,
              "points": 0,
              "text": "Every manifesto red line holds. MPs in marginal seats have nothing to explain on the doorstep.",
              "sources": [
                {
                  "sourceId": "labour-manifesto-2024-strong-foundations"
                },
                {
                  "sourceId": "hmt-budget-2025-speech"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "crossed",
              "points": -1,
              "text": "A manifesto red line is crossed, and the words are on the record. Marginal-seat MPs will be asked first.",
              "sources": [
                {
                  "sourceId": "labour-manifesto-2024-strong-foundations"
                },
                {
                  "sourceId": "hmt-budget-2025-speech"
                }
              ],
              "badge": "simulated"
            }
          ]
        },
        {
          "id": "bb-manifesto-strain",
          "measure": "manifestoStrained",
          "reading": {
            "label": "Manifesto promises strained",
            "unit": "count"
          },
          "note": "The levy, the employer-side National Insurance charges and a new top rate keep the pledge’s words and test its spirit: the government’s own reading in October 2024, contested then and now. Amber, not red: one point, and no floor.",
          "bands": [
            {
              "id": "kept",
              "upTo": 0,
              "points": 0,
              "text": "Nothing here tests the pledge’s spirit while keeping its words.",
              "sources": [
                {
                  "sourceId": "labour-manifesto-2024-strong-foundations"
                },
                {
                  "sourceId": "hmt-autumn-budget-2024-table-5-1",
                  "table": "Table 5.1",
                  "note": "line 26"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "strained",
              "points": -1,
              "text": "A tax rise that keeps the letter of the manifesto and not its spirit. The benches will argue about it.",
              "sources": [
                {
                  "sourceId": "labour-manifesto-2024-strong-foundations"
                },
                {
                  "sourceId": "hmt-autumn-budget-2024-table-5-1",
                  "table": "Table 5.1",
                  "note": "line 26"
                }
              ],
              "badge": "simulated"
            }
          ]
        },
        {
          "id": "bb-downing-street",
          "measure": "prioritiesUnfunded",
          "reading": {
            "label": "Flagships agreed with the Prime Minister no longer funded",
            "unit": "count"
          },
          "note": "Any priority agreed in Downing Street with nothing behind it.",
          "bands": [
            {
              "id": "delivered",
              "upTo": 0,
              "points": 0,
              "text": "Everything agreed in Downing Street has something behind it in the Budget.",
              "sources": [
                {
                  "sourceId": "no10-first-speech-2026-07-20"
                },
                {
                  "sourceId": "no10-commons-statement-2026-09-01"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "pulled",
              "points": -1,
              "text": "A priority agreed in Downing Street has nothing behind it. No. 10 will notice before anyone else.",
              "sources": [
                {
                  "sourceId": "no10-first-speech-2026-07-20"
                },
                {
                  "sourceId": "no10-commons-statement-2026-09-01"
                }
              ],
              "badge": "simulated"
            }
          ]
        }
      ]
    },
    {
      "id": "markets",
      "title": "The markets",
      "question": "Is the headroom enough? What about growth and the tax burden?",
      "labels": ["Alarmed", "Nervous", "Watchful", "Reassured", "Relaxed"],
      "rules": [
        {
          "id": "mk-headroom",
          "measure": "stabilityHeadroomGbpm",
          "reading": {
            "label": "Headroom against the stability rule",
            "unit": "GBPm"
          },
          "note": "Ten billion is where commentators called the margin wafer-thin before the last Budget doubled it to £21.7bn; twenty is your advisers’ rule of thumb and about what March left.",
          "nudge": "{gap} more headroom would have moved the markets up a band.",
          "bands": [
            {
              "id": "missed",
              "upTo": -1,
              "points": -2,
              "cap": 2,
              "text": "The stability rule is missed, and the OBR will say so on Budget day. Gilt investors read that first.",
              "sources": [
                {
                  "sourceId": "hmt-charter-2025-autumn",
                  "paragraph": "3.6-3.11"
                },
                {
                  "sourceId": "boe-insights-long-rates-2025"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "thin",
              "upTo": 10000,
              "points": -1,
              "text": "Headroom of {value} is below the ten billion commentators called wafer-thin before the last Budget. Thin margins are noticed.",
              "sources": [
                {
                  "sourceId": "ifg-healey-tax-budget-2026"
                },
                {
                  "sourceId": "hmt-budget-2025-speech"
                },
                {
                  "sourceId": "boe-fsr-2026-07"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "modest",
              "upTo": 20000,
              "points": 0,
              "text": "Headroom of {value}: less than March left, and smaller than the OBR’s typical forecast error of about £32bn.",
              "sources": [
                {
                  "sourceId": "obr-efo-2026-03",
                  "paragraph": "3.4"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "ample",
              "points": 1,
              "text": "Headroom of {value}, inside the twenty billion your advisers call comfortable: about what March left. A buffer, as promised.",
              "sources": [
                {
                  "sourceId": "hmt-tsc-budget-2026-letter"
                },
                {
                  "sourceId": "hmt-budget-2025-speech"
                }
              ],
              "badge": "simulated"
            }
          ]
        },
        {
          "id": "mk-borrowing",
          "measure": "borrowingChangeGbpm",
          "reading": {
            "label": "Change in borrowing in the target year",
            "unit": "GBPm"
          },
          "note": "Five billion less is a change in the financing remit the market notices; ten billion more is an issuance programme it prices.",
          "nudge": "{gap} less borrowing in the target year would have moved this up a band.",
          "bands": [
            {
              "id": "less",
              "upTo": -5000,
              "points": 1,
              "text": "Borrowing in the target year is {abs} lower than forecast: fewer gilts to sell into a nervous market.",
              "sources": [
                {
                  "sourceId": "boe-iadb-gilt-10y"
                },
                {
                  "sourceId": "obr-efo-2026-03"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "flat",
              "upTo": 10000,
              "points": 0,
              "text": "Borrowing is close to where the forecast had it ({value}). Yields at 5.35% against the OBR’s 4.5% matter more.",
              "sources": [
                {
                  "sourceId": "boe-iadb-gilt-10y"
                },
                {
                  "sourceId": "obr-efo-2026-03"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "more",
              "points": -1,
              "text": "Borrowing is {abs} higher than forecast: more gilts to sell where yields were already 5.35% against 4.5%.",
              "sources": [
                {
                  "sourceId": "boe-iadb-gilt-10y"
                },
                {
                  "sourceId": "obr-efo-2026-03"
                }
              ],
              "badge": "simulated"
            }
          ]
        },
        {
          "id": "mk-tax-burden",
          "measure": "taxTakeChangePp",
          "reading": {
            "label": "Change in the tax take as a share of the economy",
            "unit": "pp"
          },
          "note": "Half a point of GDP on top of a tax take the OBR already calls a historic high.",
          "nudge": "{gap} less on the tax take would have kept the markets neutral on it.",
          "bands": [
            {
              "id": "steady",
              "upTo": 0.5,
              "points": 0,
              "text": "The tax take moves by {value}. The forecast already reaches 38.5% of GDP by 2030-31, a historic high.",
              "sources": [
                {
                  "sourceId": "obr-efo-2026-03"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "higher",
              "points": -1,
              "text": "The tax take rises by {value}, on top of 38.5% of GDP by 2030-31, already a historic high.",
              "sources": [
                {
                  "sourceId": "obr-efo-2026-03"
                }
              ],
              "badge": "simulated"
            }
          ]
        },
        {
          "id": "mk-investment",
          "measure": "capitalChangeGbpm",
          "reading": {
            "label": "Change in public investment in the target year",
            "unit": "GBPm"
          },
          "note": "A cut of more than about two billion a year to capital budgets.",
          "bands": [
            {
              "id": "cut",
              "upTo": -2000,
              "points": -1,
              "text": "Public investment is cut by {abs}. The 2024 rules were written so it would not be the first thing cut.",
              "sources": [
                {
                  "sourceId": "hmt-strong-fiscal-framework-2024-10"
                },
                {
                  "sourceId": "hmt-charter-2025-autumn",
                  "paragraph": "3.33-3.44"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "kept",
              "points": 0,
              "text": "Public investment is {value} against the plan. It counts against the debt rule, not the stability rule.",
              "sources": [
                {
                  "sourceId": "hmt-charter-2025-autumn",
                  "paragraph": "3.33-3.44"
                }
              ],
              "badge": "simulated"
            }
          ]
        },
        {
          "id": "mk-debt-rule",
          "measure": "investmentRuleStatus",
          "reading": {
            "label": "The investment rule",
            "unit": "status"
          },
          "note": "Met, or missed: net financial liabilities falling as a share of GDP in the target year.",
          "bands": [
            {
              "id": "met",
              "upTo": 1,
              "points": 0,
              "text": "Net financial liabilities still fall as a share of the economy: the investment rule is met.",
              "sources": [
                {
                  "sourceId": "hmt-charter-2025-autumn",
                  "paragraph": "3.33-3.44"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "missed",
              "points": -1,
              "text": "Debt no longer falls in the target year: the investment rule is missed. Gilt investors watch the debt path.",
              "sources": [
                {
                  "sourceId": "hmt-charter-2025-autumn",
                  "paragraph": "3.33-3.44"
                },
                {
                  "sourceId": "obr-efo-2026-03"
                }
              ],
              "badge": "simulated"
            }
          ]
        },
        {
          "id": "mk-credibility",
          "measure": "credibilityShare",
          "reading": {
            "label": "Share of the improvement resting on uncertified costings",
            "unit": "ratio"
          },
          "note": "Two-fifths of the yield: beyond that the OBR’s own scoring, not the Budget, sets the number.",
          "bands": [
            {
              "id": "certified",
              "upTo": 0.4,
              "points": 0,
              "text": "What improves the current budget rests mostly on HMRC rows and Treasury lines the OBR will certify.",
              "sources": [
                {
                  "sourceId": "osr-trr-review-2025-12"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "doubted",
              "points": -1,
              "text": "More than two-fifths of the yield rests on figures nobody has certified. The OBR may score them lower.",
              "sources": [
                {
                  "sourceId": "hmrc-tax-reliefs-quality-report"
                },
                {
                  "sourceId": "osr-trr-review-2025-12"
                }
              ],
              "badge": "simulated",
              "variants": [
                {
                  "when": {
                    "measure": "reliefShareOfUncertified",
                    "above": 0.5
                  },
                  "text": "More than two-fifths of the yield is what tax breaks cost today. HMRC says ending them raises less.",
                  "sources": [
                    {
                      "sourceId": "hmrc-tax-reliefs-quality-report",
                      "paragraph": "4"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "public",
      "title": "The public",
      "question": "Did it make a difference to them?",
      "labels": ["Furious", "Sceptical", "Shrugging", "Approving", "Delighted"],
      "rules": [
        {
          "id": "pb-manifesto",
          "measure": "manifestoBroken",
          "reading": {
            "label": "Manifesto promises broken",
            "unit": "count"
          },
          "note": "One is enough. A broken promise on tax or welfare pins the rating at the floor whatever else the Budget does.",
          "bands": [
            {
              "id": "kept",
              "upTo": 0,
              "points": 0,
              "text": "Every manifesto promise on tax and welfare holds.",
              "sources": [
                {
                  "sourceId": "labour-manifesto-2024-strong-foundations"
                },
                {
                  "sourceId": "hmt-budget-2025-speech"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "broken",
              "points": -2,
              "cap": 1,
              "text": "A manifesto promise has been broken. The pledge was made on every doorstep, and nothing else will be heard.",
              "sources": [
                {
                  "sourceId": "labour-manifesto-2024-strong-foundations"
                },
                {
                  "sourceId": "hmt-budget-2025-speech"
                }
              ],
              "badge": "simulated"
            }
          ]
        },
        {
          "id": "pb-manifesto-strain",
          "measure": "manifestoStrained",
          "reading": {
            "label": "Manifesto promises strained",
            "unit": "count"
          },
          "note": "A promise kept in the words and tested in the spirit costs a point, never the floor: the floor is for the pledge’s own words.",
          "bands": [
            {
              "id": "kept",
              "upTo": 0,
              "points": 0,
              "text": "Nothing here tests the pledge’s spirit while keeping its words.",
              "sources": [
                {
                  "sourceId": "labour-manifesto-2024-strong-foundations"
                },
                {
                  "sourceId": "hmt-autumn-budget-2024-table-5-1",
                  "table": "Table 5.1",
                  "note": "line 26"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "strained",
              "points": -1,
              "text": "A promise kept in the words and tested in the spirit. People notice a National Insurance rise by another name.",
              "sources": [
                {
                  "sourceId": "labour-manifesto-2024-strong-foundations"
                },
                {
                  "sourceId": "hmt-autumn-budget-2024-table-5-1",
                  "table": "Table 5.1",
                  "note": "line 26"
                }
              ],
              "badge": "simulated"
            }
          ]
        },
        {
          "id": "pb-priorities",
          "measure": "prioritiesFunded",
          "reading": {
            "label": "Priorities with a way to deliver them on",
            "unit": "count"
          },
          "note": "A priority counts when at least one way to deliver it is on in the package.",
          "bands": [
            {
              "id": "none",
              "upTo": 0,
              "points": 0,
              "text": "No priority was carried through to something people can point at.",
              "sources": [
                {
                  "sourceId": "no10-first-speech-2026-07-20"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "one",
              "upTo": 1,
              "points": 1,
              "text": "One of the Budget’s priorities shows up in something people will notice.",
              "sources": [
                {
                  "sourceId": "no10-first-speech-2026-07-20"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "all",
              "points": 2,
              "text": "Two or more of the Budget’s priorities are funded. People can see what it was for.",
              "sources": [
                {
                  "sourceId": "no10-first-speech-2026-07-20"
                },
                {
                  "sourceId": "no10-commons-statement-2026-09-01"
                }
              ],
              "badge": "simulated"
            }
          ]
        },
        {
          "id": "pb-clear-priority",
          "measure": "clearPriorityGbpm",
          "reading": {
            "label": "Money behind a single, fully delivered priority",
            "unit": "GBPm"
          },
          "note": "One priority ranked, delivered, and at least five billion a year behind it: a Budget people can describe in a sentence.",
          "nudge": "{gap} more behind a single priority would have made it a story people can describe.",
          "bands": [
            {
              "id": "no",
              "upTo": 4999,
              "points": 0,
              "text": "There is no single story: more than one priority, an option cut back, or too little money behind it.",
              "sources": [
                {
                  "sourceId": "no10-first-speech-2026-07-20"
                }
              ],
              "badge": "simulated"
            },
            {
              "id": "yes",
              "points": 1,
              "text": "One clear priority with {value} a year behind it: a Budget people can describe in a sentence.",
              "sources": [
                {
                  "sourceId": "no10-first-speech-2026-07-20"
                }
              ],
              "badge": "simulated"
            }
          ]
        },
        {
          "id": "pb-tax-rises",
          "measure": "taxRisesGbpm",
          "reading": {
            "label": "Tax rises in the target year",
            "unit": "GBPm"
          },

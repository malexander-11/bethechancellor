    {
      "id": "mortgage-couple",
      "who": "A couple on median earnings with a mortgage",
      "fact": {
        "text": "Ten-year gilt yields were about 5.3% in September against the 4.5% the March forecast assumed; fixed mortgage rates follow gilts.",
        "sources": [
          {
            "sourceId": "boe-iadb-gilt-10y"
          }
        ],
        "badge": "simulated"
      },
      "touches": [
        {
          "code": "itbr",
          "when": "above",
          "effect": "pays",
          "line": {
            "text": "A penny on the basic rate. We both pay it, on every pound above the allowance, and the allowance is frozen too.",
            "sources": [
              {
                "sourceId": "obr-efo-2026-03",
                "paragraph": "3.2"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "itbr",
          "when": "below",
          "effect": "gains",
          "line": {
            "text": "A penny off the basic rate. It is the first tax cut we have actually seen in a payslip.",
            "sources": [],
            "badge": "simulated"
          }
        },
        {
          "code": "rvfrz",
          "when": "on",
          "effect": "gains",
          "line": {
            "text": "The thresholds unfreeze in 2028. Later than we would like, but it stops the quiet tax rise the last lot built in.",
            "sources": [
              {
                "sourceId": "obr-efo-2026-03",
                "paragraph": "3.2"
              },
              {
                "sourceId": "hmt-budget-2025-speech"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "nicm",
          "when": "above",
          "effect": "pays",
          "line": {
            "text": "National Insurance up. That was the one they promised not to touch.",

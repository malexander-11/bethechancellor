              {
                "sourceId": "hmrc-tax-reliefs-2026-01"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "nicpt",
          "when": "above",
          "effect": "gains",
          "line": {
            "text": "The National Insurance threshold goes up. We both pay a bit less on every payslip.",

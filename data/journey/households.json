            "badge": "simulated"
          }
        },
        {
          "code": "vatkids",
          "when": "on",
          "effect": "pays",
          "line": {
            "text": "VAT on children’s clothes and shoes. They grow out of everything, and now all of it carries VAT.",
            "sources": [
              {
                "sourceId": "hmrc-tax-reliefs-2026-01"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "vattrn",
          "when": "on",
          "effect": "pays",
          "line": {
            "text": "VAT on bus and train fares. The bus is how I get to work, and every ticket costs more.",
            "sources": [
              {
                "sourceId": "hmrc-tax-reliefs-2026-01"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "vat1z",
          "when": "on",
          "effect": "pays",
          "line": {
            "text": "A penny in the pound of VAT on food and the children’s clothes. It is on the things we cannot cut.",
            "sources": [
              {
                "sourceId": "ifs-green-budget-2025"
              }
            ],
            "badge": "simulated"
          }
        }
      ],
      "exposure": [
        "broad-base",
        "duties",
        "families-on-benefits",
        "disabled-people",
        "schools",
        "renters",
        "transport",
        "motorists",
        "nhs"
      ],
      "untouched": {
        "text": "Nothing in it for us either way. The rent is the same, the shop is the same, the statement is the same.",
        "sources": [],
        "badge": "simulated"
      },
      "understood": {
        "text": "I could tell what it was for. Whether it reaches us is another matter, but at least I know what they were trying to do.",
        "sources": [],

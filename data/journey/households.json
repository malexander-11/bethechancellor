              {
                "sourceId": "labour-manifesto-2024-strong-foundations"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "vats",
          "when": "above",
          "effect": "pays",
          "line": {
            "text": "VAT up. Everything from the car service to the school shoes costs more, and it is the promise they said they would keep.",
            "sources": [
              {
                "sourceId": "labour-manifesto-2024-strong-foundations"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "vatnrg",
          "when": "on",
          "effect": "pays",
          "line": {
            "text": "VAT on gas and electricity at the full rate, after they took it off electricity in October. We do not understand which way they are going.",
            "sources": [
              {
                "sourceId": "govuk-vat-electricity-cut-2026"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "sdlt5",
          "when": "above",
          "effect": "pays",
          "line": {
            "text": "More stamp duty. We were hoping to move next year; that just got harder.",
            "sources": [],
            "badge": "simulated"
          }
        },
        {
          "code": "fuel",
          "when": "below",
          "effect": "gains",
          "line": {
            "text": "Cheaper fuel. Two cars, two commutes, so we notice it.",
            "sources": [],
            "badge": "simulated"
          }
        },
        {
          "code": "dhsc",
          "when": "above",
          "effect": "gains",
          "line": {
            "text": "More for the NHS. We have been waiting eleven months for an appointment; if this shortens it, it is worth more than a tax cut.",

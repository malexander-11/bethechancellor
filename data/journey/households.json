            "badge": "simulated"
          }
        },
        {
          "code": "wdis",
          "when": "below",
          "effect": "pays",
          "line": {
            "text": "Disability benefits cut. My partner’s PIP is part of that line.",
            "sources": [],
            "badge": "simulated"
          }
        },
        {
          "code": "wdis",
          "when": "above",
          "effect": "gains",
          "line": {
            "text": "More for disability benefits. My partner’s PIP is part of that line.",

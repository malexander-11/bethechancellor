              {
                "sourceId": "govuk-nics-rates"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "nicpt",
          "when": "below",
          "effect": "pays",
          "line": {
            "text": "The National Insurance threshold comes down. We both pay a bit more on every payslip.",
            "sources": [
              {
                "sourceId": "govuk-nics-rates"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "nicst",
          "when": "below",
          "effect": "pays",
          "line": {
            "text": "Employer National Insurance starts sooner on our pay. The firm pays it first; over time it comes out of pay rises.",
            "sources": [
              {
                "sourceId": "hmrc-tiin-employer-nics-2024"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "itpa",
          "when": "above",
          "effect": "gains",
          "line": {
            "text": "The personal allowance goes up. We both keep a bit more of every payslip.",

            "badge": "simulated"
          }
        },
        {
          "code": "dfe",
          "when": "below",
          "effect": "pays",
          "line": {
            "text": "Less for schools. The children notice that before we do.",
            "sources": [],
            "badge": "simulated"
          }
        },
        {
          "code": "dfe",
          "when": "above",
          "effect": "gains",
          "line": {
            "text": "More for schools. With two children in them, we should see it.",

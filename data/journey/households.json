            "badge": "simulated"
          }
        },
        {
          "code": "sdltabol",
          "when": "on",
          "effect": "gains",
          "line": {
            "text": "Stamp duty scrapped on the home you live in. We were hoping to move next year; that just got easier.",
            "sources": [
              {
                "sourceId": "asi-stamped-out-2025"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "cgtprr",
          "when": "on",
          "effect": "pays",
          "line": {
            "text": "Capital gains tax on our own home. If we sell to move, part of what it gained goes in tax.",

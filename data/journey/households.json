            ],
            "badge": "simulated"
          }
        },
        {
          "code": "vatfood",
          "when": "on",
          "effect": "pays",
          "line": {
            "text": "VAT on food. The weekly shop is the one bill we cannot cut, and it just went up by a fifth.",
            "sources": [],
            "badge": "simulated"
          }
        },
        {
          "code": "bus2",
          "when": "on",
          "effect": "gains",
          "line": {
            "text": "The £2 bus fare stays. That is how the children get to school and how I get to work.",
            "sources": [
              {
                "sourceId": "govuk-bus-fare-cap-2027"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "fuel",
          "when": "below",
          "effect": "gains",
          "line": {
            "text": "Cheaper petrol helps a little, when we can afford to fill up at all.",

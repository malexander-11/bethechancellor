{
  "schemaVersion": 1,
  "households": [
    {
      "id": "uc-family",
      "who": "A family on universal credit with two children",
      "fact": {
        "text": "Ending the two-child limit was scored as lifting 450,000 children out of poverty from April 2026.",
        "sources": [
          {
            "sourceId": "hmt-budget-2025-document",
            "quote": "lifting 450,000 children out of poverty"
          }
        ],
        "badge": "simulated"
      },
      "touches": [
        {
          "code": "rv2ch",
          "when": "on",
          "effect": "pays",
          "line": {
            "text": "The two-child limit is back. We were told in November it was gone for good; the money for the second child goes with it.",
            "sources": [
              {
                "sourceId": "hmt-budget-2025-document"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "wuc",
          "when": "below",
          "effect": "pays",
          "line": {
            "text": "Universal credit is cut. Every pound of it was already spent before it arrived.",
            "sources": [],
            "badge": "simulated"
          }
        },
        {
          "code": "wuc",
          "when": "above",
          "effect": "gains",
          "line": {
            "text": "Universal credit goes up. It is the first Budget in years where the number on the statement went the right way.",
            "sources": [],
            "badge": "simulated"
          }
        },
        {
          "code": "ufsm",
          "when": "on",
          "effect": "gains",
          "line": {
            "text": "Free school meals for both of them, without the form. That is a bill gone and a bit of dignity back.",
            "sources": [
              {
                "sourceId": "dfe-fsm-expansion-2026-27"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "rvfrz",
          "when": "on",
          "effect": "gains",
          "line": {
            "text": "The thresholds will rise again from 2028. On our wages that is a few pounds a month back, eventually.",

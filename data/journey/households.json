              {
                "sourceId": "govuk-elective-reform-plan-2025"
              }
            ],
            "badge": "simulated"
          }
        },
        {
          "code": "nicer",
          "when": "above",
          "effect": "pays",
          "line": {
            "text": "Employer National Insurance up. The firm pays it first; over time it comes out of pay rises.",
            "sources": [

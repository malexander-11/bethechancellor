{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "regions": ["lhr1"],
  "functions": {
    "api/*.js": { "includeFiles": "apps/server/dist/**", "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/health", "destination": "/api/app" },
    { "source": "/shared", "destination": "/api/app" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}

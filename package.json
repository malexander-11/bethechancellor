{
  "name": "bethechancellor",
  "version": "0.1.0",
  "private": true,
  "description": "Be the Chancellor: a sourced, transparent UK fiscal trade-offs game",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @btc/web",
    "build": "npm run build -w @btc/web",
    "preview": "npm run preview -w @btc/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --project engine",
    "validate:data": "npm run validate -w @btc/pipeline",
    "check:derived": "npm run check-drift -w @btc/pipeline",
    "fetch:sources": "npm run fetch -w @btc/pipeline"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.0.0"
  }
}

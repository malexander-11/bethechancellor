{
  "name": "bethechancellor",
  "version": "0.1.0",
  "private": true,
  "description": "A sourced, transparent game about the trade-offs in a UK Budget: What’s your Budget?",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @btc/web",
    "build": "npm run build -w @btc/web",
    "preview": "npm run preview -w @btc/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "validate:data": "npm run validate -w @btc/pipeline",
    "check:derived": "npm run check-drift -w @btc/pipeline",
    "gate": "npm run lint && npm run format:check && npm run typecheck && npm run validate:data && npm run check:derived && npm run test:coverage && npm run build && npm run e2e",
    "fetch:sources": "npm run fetch -w @btc/pipeline"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "1.56.1",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.0.0"
  }
}
